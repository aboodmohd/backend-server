{
  "name": "video-resolver-backend",
  "version": "2.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "PLAYWRIGHT_BROWSERS_PATH=0 tsx watch src/server.ts",
    "postinstall": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "start": "npm run build && PLAYWRIGHT_BROWSERS_PATH=0 node dist/server.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ioredis": "^5.8.0",
    "playwright": "^1.55.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
